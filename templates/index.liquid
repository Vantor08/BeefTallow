{%- comment -%}
  SHOPIFY PAGE MAPPING: templates/index.liquid -> HOME PAGE
  Self-contained: all homepage content + its own styles live in this one file.
{%- endcomment -%}
{%- assign ph = settings.product_handle | default: 'face-ritual-tallow-balm' -%}
{%- assign purl = '/products/' | append: ph -%}

<style>
  .home-hero{max-width:1200px;margin:0 auto;padding:48px 20px 24px;display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
  .home-hero__media{background:var(--bg3);border-radius:18px;overflow:hidden;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center}
  .home-hero__media span{font-family:var(--serif);font-size:2.4rem;color:var(--gold)}
  .home-hero h1{font-size:clamp(2rem,4.6vw,3.3rem);margin:14px 0}
  .home-hero__sub{font-size:1.1rem;opacity:.78;margin-bottom:18px;max-width:44ch}
  .home-hero__price{display:flex;align-items:center;gap:12px;margin:20px 0}
  .home-hero__cta{display:flex;flex-direction:column;gap:10px;max-width:360px}
  .home-hero__micro{font-size:.82rem;opacity:.6}
  .home-hero__bene{display:flex;gap:26px;margin-top:26px;flex-wrap:wrap}
  .home-hero__bene div b{display:block;font-size:.92rem}
  .home-hero__bene div span{font-size:.8rem;opacity:.6}
  .pains{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:38px}
  .pain{background:var(--bg2);border:1px solid var(--line);border-radius:16px;padding:28px 24px;text-align:left}
  .pain__i{font-size:1.6rem;margin-bottom:12px}
  .pain h3{font-size:1.25rem;margin-bottom:8px}
  .pain p{opacity:.72;font-size:.95rem}
  .feats{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:38px;text-align:left}
  .feat{display:flex;gap:16px;background:var(--bg3);border-radius:16px;padding:24px}
  .feat__i{font-size:1.7rem;line-height:1}
  .feat h3{font-size:1.15rem;margin-bottom:6px}
  .feat p{opacity:.72;font-size:.93rem}
  .socialrow{display:flex;justify-content:center;gap:48px;margin-top:40px}
  .socialrow b{font-family:var(--serif);font-size:2rem;font-weight:300;color:var(--gold);display:block}
  .socialrow span{font-size:.78rem;opacity:.6;text-transform:uppercase;letter-spacing:.08em}
  .angle{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;max-width:1100px;margin:0 auto;padding:60px 20px}
  .angle:nth-child(even) .angle__media{order:2}
  .angle__media{background:var(--bg3);border-radius:16px;aspect-ratio:4/5;display:flex;align-items:center;justify-content:center;color:var(--gold);font-family:var(--serif);padding:30px;text-align:center}
  .angle h2{font-size:clamp(1.6rem,3.4vw,2.3rem);margin:10px 0 14px}
  .angle p{opacity:.78;margin-bottom:12px}
  .ings{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:38px}
  .ing{background:var(--bg2);border:1px solid var(--line);border-radius:16px;padding:26px 20px;text-align:center}
  .ing__i{font-size:2rem;margin-bottom:12px}
  .ing h3{font-size:1.05rem;margin-bottom:8px}
  .ing p{opacity:.72;font-size:.88rem}
  .revwrap{overflow:hidden;max-width:560px;margin:34px auto 0}
  .revtrack{display:flex;transition:transform .5s ease}
  .revcard{min-width:100%;background:var(--bg2);border:1px solid var(--line);border-radius:16px;padding:28px;text-align:left}
  .revcard__h{display:flex;align-items:center;gap:12px;margin-bottom:14px}
  .revav{width:44px;height:44px;border-radius:50%;background:var(--gold);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700}
  .revname{font-weight:700;font-size:.95rem}
  .revloc{font-size:.8rem;opacity:.6}
  .revverified{margin-left:auto;font-size:.72rem;color:var(--gold);font-weight:600}
  .revdots{display:flex;justify-content:center;gap:8px;margin-top:18px}
  .revdot{width:9px;height:9px;border-radius:50%;border:none;background:var(--line);cursor:pointer;padding:0}
  .revdot.active{background:var(--gold)}
  .finalcta{background:var(--brown);color:var(--ctatext);text-align:center;padding:72px 20px}
  .finalcta h2{font-size:clamp(1.8rem,4vw,2.8rem);margin:10px 0 14px}
  .finalcta p{opacity:.8;max-width:50ch;margin:0 auto 24px}
  .finalcta__price{display:flex;justify-content:center;align-items:center;gap:12px;margin-bottom:22px}
  .finalcta__price .now{font-family:var(--serif);font-size:2.2rem;color:var(--gold2)}
  .finalcta__price .was{text-decoration:line-through;opacity:.5}
  .finalcta__trust{display:flex;justify-content:center;gap:24px;flex-wrap:wrap;margin-top:22px;font-size:.85rem;opacity:.8}
  @media(max-width:768px){
    .home-hero{grid-template-columns:1fr;padding-top:28px}
    .home-hero__media{order:-1}
    .pains,.feats,.ings{grid-template-columns:1fr}
    .angle{grid-template-columns:1fr;gap:24px}
    .angle:nth-child(even) .angle__media{order:-1}
    .socialrow{gap:32px}
  }
</style>

