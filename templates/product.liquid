{%- comment -%}
  SHOPIFY PAGE MAPPING: templates/product.liquid -> PRODUCT PAGE
  Self-contained: full long-form product page + its own styles in one file.
  Buy box posts to Shopify /cart/add. Bundle tiers are built from the product's real variants.
{%- endcomment -%}
{%- assign cv = product.selected_or_first_available_variant -%}

<style>
  .pdp{max-width:1200px;margin:0 auto;padding:40px 20px;display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start}
  .pdp__media{position:sticky;top:90px}
  .pdp__main{background:var(--bg3);border-radius:16px;overflow:hidden;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;color:var(--gold);font-family:var(--serif);font-size:2rem}
  .pdp h1{font-size:clamp(1.8rem,3.6vw,2.6rem);margin:8px 0}
  .pdp__sub{opacity:.78;margin:14px 0}
  .pdp__bullets{list-style:none;margin:18px 0;display:flex;flex-direction:column;gap:10px}
  .pdp__bullets li{display:flex;gap:10px;align-items:flex-start;font-size:.96rem}
  .pdp__bullets .ck{color:var(--gold);font-weight:700}
  .tier{display:block;border:2px solid var(--line);border-radius:14px;padding:16px 18px;margin-bottom:10px;cursor:pointer;position:relative;transition:.15s}
  .tier.selected{border-color:var(--gold);background:var(--bg3)}
  .tier__row{display:flex;align-items:center;justify-content:space-between;gap:12px}
  .tier__name{font-weight:700}
  .tier__desc{font-size:.84rem;opacity:.65}
  .tier__price{font-family:var(--serif);font-size:1.3rem}
  .tier__badge{position:absolute;top:-10px;left:16px;background:var(--gold);color:#fff;font-size:.66rem;font-weight:700;padding:3px 8px;border-radius:999px;letter-spacing:.04em}
  .tier input{position:absolute;opacity:0}
  .pdp__reassure{display:flex;gap:16px;flex-wrap:wrap;margin-top:14px;font-size:.82rem;opacity:.7;justify-content:center}
  .pdp__pay{display:flex;gap:6px;justify-content:center;margin-top:16px;flex-wrap:wrap}
  .pdp__pay span{background:var(--bg3);border:1px solid var(--line);border-radius:5px;font-size:.6rem;font-weight:700;padding:5px 7px;opacity:.75}
  .pblock{padding:60px 20px}
  .pblock .inner{max-width:1100px;margin:0 auto}
  .pblock--dark{background:var(--brown);color:var(--ctatext)}
  .pblock--cream{background:var(--bg3)}
  .pblock h2{font-size:clamp(1.6rem,3.4vw,2.3rem);text-align:center;margin-bottom:8px}
  .pblock .sub{text-align:center;opacity:.72;max-width:600px;margin:0 auto 32px}
  .cards3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .card3{background:var(--bg2);border:1px solid var(--line);border-radius:16px;padding:26px 22px}
  .pblock--dark .card3{background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.12)}
  .card3 .i{font-size:1.6rem;margin-bottom:10px}
  .card3 .num{width:32px;height:32px;border-radius:50%;background:var(--gold);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;margin-bottom:12px}
  .card3 h3{font-size:1.15rem;margin-bottom:8px}
  .card3 .out{color:var(--gold);font-weight:600;margin-bottom:6px;font-size:.95rem}
  .card3 p{opacity:.74;font-size:.92rem}
  .pblock--dark .card3 p{opacity:.8}
  .ctbl{width:100%;border-collapse:collapse;margin-top:10px;background:var(--bg2);border-radius:14px;overflow:hidden}
  .ctbl th,.ctbl td{padding:14px 12px;text-align:center;border-bottom:1px solid var(--line);font-size:.92rem}
  .ctbl th{font-family:var(--serif);font-weight:500}
  .ctbl th:last-child,.ctbl td:last-child{background:var(--bg3)}
  .ctbl td:first-child{text-align:left;font-weight:600}
  .yes{color:#2e7d32;font-weight:700}.no{color:#c0392b}
  .gbox{display:flex;gap:28px;align-items:center;max-width:860px;margin:0 auto;background:var(--bg2);border:1px solid var(--line);border-radius:18px;padding:32px}
  .gbox__badge{min-width:96px;height:96px;border-radius:50%;background:var(--gold);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:var(--serif);font-size:2rem;line-height:1}
  .gbox__badge small{font-size:.6rem;letter-spacing:.1em}
  .faq{max-width:760px;margin:0 auto}
  .faqi{border-bottom:1px solid var(--line)}
  .faqi__q{width:100%;background:none;border:none;text-align:left;padding:18px 0;font-size:1.02rem;font-weight:600;cursor:pointer;display:flex;justify-content:space-between;gap:12px;color:inherit}
  .faqi__q .pm{color:var(--gold);transition:.2s}
  .faqi.open .faqi__q .pm{transform:rotate(45deg)}
  .faqi__a{max-height:0;overflow:hidden;transition:max-height .3s ease}
  .faqi.open .faqi__a{max-height:320px}
  .faqi__a p{padding:0 0 18px;opacity:.76;font-size:.95rem}
  .sticky-atc{position:fixed;left:0;right:0;bottom:0;background:var(--bg2);border-top:1px solid var(--line);box-shadow:0 -4px 20px rgba(0,0,0,.08);padding:12px 20px;display:flex;justify-content:space-between;align-items:center;gap:16px;transform:translateY(120%);transition:.25s;z-index:60}
  .sticky-atc.show{transform:translateY(0)}
  .sticky-atc b{font-size:.95rem}
  @media(max-width:768px){
    .pdp{grid-template-columns:1fr;gap:28px}.pdp__media{position:static}
    .cards3{grid-template-columns:1fr}
    .ctbl{font-size:.8rem}.ctbl th,.ctbl td{padding:10px 6px}
    .gbox{flex-direction:column;text-align:center}
  }
</style>

<section class="pdp" id="buy">
  <div class="pdp__media">
    <div class="pdp__main">
      {%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title }}" width="600" height="600">{%- else -%}Vallore™{%- endif -%}
    </div>
  </div>
  <div class="pdp__buy">
    <p class="overline">The Vallore™ Face Ritual</p>
    <h1>{{ product.title | default: 'Vallore™ Tallow Face Balm' }}</h1>
    <div class="rating-row"><span class="stars stars-lg">★★★★★</span><span style="font-weight:700">4.8</span><span class="count">· 2,140+ verified reviews</span></div>
    <p class="pdp__sub">{{ product.description | default: 'The one-step routine for men who skip the whole routine — grass-fed tallow, raw honey, jojoba, nothing else.' }}</p>
    <ul class="pdp__bullets">
      <li><span class="ck">✓</span>Looks rested in the mirror — even on 5 hours of sleep</li>
      <li><span class="ck">✓</span>Shave without the sting, burn, or razor rash</li>
      <li><span class="ck">✓</span>Replaces 5 bathroom products with one jar</li>
      <li><span class="ck">✓</span>Ten-second habit you'll actually keep</li>
    </ul>
    <form action="/cart/add" method="post" id="pdpForm">
      <input type="hidden" name="id" id="pdpVariantId" value="{{ cv.id }}">
      <p style="font-weight:600;margin-bottom:10px">Choose your supply:</p>
      {%- if product.variants.size > 1 -%}
        {%- for v in product.variants -%}
          <label class="tier{% if v.id == cv.id %} selected{% endif %}" data-tier data-variant="{{ v.id }}">
            {%- if forloop.index == 2 %}<span class="tier__badge">MOST POPULAR</span>{% endif -%}
            <input type="radio" name="tier" value="{{ v.id }}"{% if v.id == cv.id %} checked{% endif %}>
            <span class="tier__row">
              <span><span class="tier__name">{{ v.title }}</span><br><span class="tier__desc">{% if v.available %}In stock · ships in 24h{% else %}Sold out{% endif %}</span></span>
              <span class="tier__price">{{ v.price | money }}{% if v.compare_at_price > v.price %} <span class="price-compare" style="font-size:.9rem">{{ v.compare_at_price | money }}</span>{% endif %}</span>
            </span>
          </label>
        {%- endfor -%}
      {%- else -%}
        <label class="tier selected" data-tier data-variant="{{ cv.id }}">
          <input type="radio" name="tier" value="{{ cv.id }}" checked>
          <span class="tier__row"><span class="tier__name">1 Jar · 30-day supply</span><span class="tier__price">{{ cv.price | money | default: '$34.00' }}</span></span>
        </label>
      {%- endif -%}
      <button type="submit" name="add" class="btn btn-primary btn-lg btn-full" style="margin-top:14px">Add To Cart</button>
      <div class="pdp__reassure"><span>🔒 Secure checkout</span><span>🚚 Ships in 24h</span><span>↩️ 60-day guarantee</span></div>
    </form>
    <div class="pdp__pay"><span>VISA</span><span>MASTERCARD</span><span>AMEX</span><span>SHOP PAY</span><span>APPLE PAY</span></div>
  </div>
</section>

<section class="pblock">
  <div class="inner">
    <p class="overline" style="text-align:center">What Actually Changes</p>
    <h2>It's Not About Skincare. It's About How Monday Feels.</h2>
    <div class="cards3" style="margin-top:28px">
      <div class="card3"><div class="i">🪞</div><h3>Walk Past The Mirror Without Flinching</h3><p class="out">The 6am glance stops being a gut-punch.</p><p>That tired, grey, "who is that" face softens. You look like you slept — even when you didn't.</p></div>
      <div class="card3"><div class="i">📸</div><h3>Stop Dodging The Camera</h3><p class="out">You stay in the photo instead of taking it.</p><p>The flinch when someone raises a phone — gone. You stop editing yourself out of your own kid's birthday pictures.</p></div>
      <div class="card3"><div class="i">🫙</div><h3>One Jar That's Actually Yours</h3><p class="out">Ten seconds a day that are just yours.</p><p>Not her ten-step shelf. One small thing you do for yourself that happens to make your face look less wrecked by Friday.</p></div>
    </div>
  </div>
</section>

